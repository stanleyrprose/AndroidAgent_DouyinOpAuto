{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rev37-execution-route-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_version",
    "route_id",
    "route_class",
    "selected_for"
  ],
  "properties": {
    "route_version": {
      "const": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "route_class": {
      "enum": [
        "VERIFIED_NOOP",
        "SEMANTIC_UI",
        "VISION_ASSISTED_UI",
        "HOST_PRIMITIVE",
        "BLOCKED"
      ]
    },
    "selected_for": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_state",
        "device_contract",
        "evidence_revision"
      ],
      "properties": {
        "target_state": {
          "type": "string",
          "minLength": 1
        },
        "device_contract": {
          "type": "string",
          "minLength": 1
        },
        "evidence_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
