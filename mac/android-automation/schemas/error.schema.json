{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stanleyxyz.local/y700/error.schema.json",
  "type": "object",
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {
      "enum": [
        "ELEMENT_NOT_FOUND","SELECTOR_AMBIGUOUS","PRECONDITION_FAILED",
        "POSTCONDITION_FAILED","ACTION_TIMEOUT","WORKFLOW_TIMEOUT",
        "WORKFLOW_LIMIT_EXCEEDED","UI_TREE_UNAVAILABLE","UI_TREE_EMPTY",
        "UI_AUTOMATOR_DISCONNECTED","SEMANTIC_TREE_UNAVAILABLE",
        "WEBVIEW_SEMANTICS_UNAVAILABLE","COMPOSE_SEMANTICS_UNAVAILABLE",
        "SCREEN_OFF","KEYGUARD_BLOCKING","ORIENTATION_CHANGED","WINDOW_CHANGED",
        "UNEXPECTED_PACKAGE","UNEXPECTED_ACTIVITY","IME_INPUT_FAILED",
        "IME_NOT_DISMISSED","TEXT_VALUE_MISMATCH","FORM_BINDING_NOT_CONFIRMED",
        "APP_CRASHED","APP_ANR","APP_NOT_RESPONDING","APP_RELAUNCH_FAILED",
        "DRIVER_CRASHED","DRIVER_STALLED","DRIVER_RESTART_FAILED","PROTOCOL_MISMATCH",
        "NETWORK_OFFLINE","NETWORK_UNSTABLE","APP_NETWORK_ERROR",
        "JOB_CLAIM_CONFLICT","JOB_PERMISSION_DENIED","JOB_PAYLOAD_INVALID",
        "PARTIAL_PAYLOAD_DETECTED","THERMAL_THROTTLING","LOW_DISK","LOW_BATTERY",
        "EXTERNAL_SIDE_EFFECT_AMBIGUOUS","RECONCILE_REQUIRED","RECOVERY_EXHAUSTED"
      ]
    },
    "message": {"type": "string"},
    "retryable": {"type": "boolean"}
  }
}
