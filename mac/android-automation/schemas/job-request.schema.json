{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stanleyxyz.local/y700/job-request.schema.json",
  "title": "Y700 Android Automation Workflow Request",
  "type": "object",
  "required": ["protocol_version", "job_id", "actions"],
  "properties": {
    "protocol_version": {"type": "integer", "const": 1},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "max_duration_ms": {"type": "integer", "minimum": 1000, "maximum": 600000, "default": 600000},
    "auto_wake": {"type": "boolean", "default": true},
    "dismiss_keyguard": {"type": "boolean", "default": true},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "action.schema.json"}
    }
  },
  "additionalProperties": false
}
