    "last_completed_action_id": {"type": ["string","null"]},
    "last_completed_action_index": {"type": "integer", "minimum": -1},
    "next_action_index": {"type": ["integer","null"], "minimum": 0},
    "safe_to_resume": {"type": "boolean"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
